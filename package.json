    "framer-motion": "^11.3.19",
    "geist": "^1.3.1",
    "googleapis": "^173.0.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.414.0",
    "morgan": "^1.10.0",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.19",
    "nodemailer": "^7.0.13",
    "puppeteer": "^22.13.1",
    "razorpay": "^2.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-pdf": "^9.1.0",
    "recharts": "^2.12.7",
    "socket.io": "^4.7.5",
