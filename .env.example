# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KavachAI

# Database
DATABASE_URL=postgresql://kavachai:password@localhost:5432/kavachai_db

# Redis
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=your-secret-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=

# WhatsApp Business Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WEBHOOK_VERIFY_TOKEN=your-random-verify-token
META_APP_SECRET=

# Gmail / Google Workspace
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=

# Microsoft Graph (Outlook + OneDrive)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kavachai-storage

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay Plan IDs
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_GUARDIAN=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kavachai.in

# Token Encryption
TOKEN_ENCRYPTION_KEY=32-byte-hex-key-for-AES-256

# Socket.io
SOCKET_PORT=3001

# Puppeteer
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
