# =============================================================================
# KavachAI — PRODUCTION environment template (free-tier deployment)
# =============================================================================
# Copy the REQUIRED block into your host's environment settings (Render, etc.).
# Generate secrets with the commands shown in the comments.
# Everything under OPTIONAL can stay blank until you connect that integration.

# ---------- REQUIRED (app will not boot without these) -----------------------

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Postgres — free at https://neon.tech (include ?sslmode=require)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Redis — free at https://upstash.com (use the rediss:// URL)
REDIS_URL=rediss://default:pass@host:6379

# Auth — generate secret with: openssl rand -base64 48
NEXTAUTH_SECRET=replace-with-generated-48-char-secret
NEXTAUTH_URL=https://your-app.onrender.com
NEXT_PUBLIC_APP_URL=https://your-app.onrender.com

# Token encryption — generate with: openssl rand -hex 32  (MUST be 64 hex chars)
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# Any random string (only used when you later connect WhatsApp)
META_WEBHOOK_VERIFY_TOKEN=any-random-string

# AI key — REQUIRED to be non-empty for the app to boot, but only actually
# called when live messages are processed. Use a placeholder now; paste a real
# Anthropic key here later to enable AI classification.
ANTHROPIC_API_KEY=placeholder-add-real-anthropic-key-later

# ---------- OPTIONAL (leave blank until you enable the feature) ---------------

# Google login + Gmail/Drive scanning (FREE to create in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=

# Microsoft Outlook/OneDrive (FREE Azure app registration)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# WhatsApp Business Cloud API (Meta — free tier)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_APP_SECRET=

# File storage for PDFs/audit logs (AWS S3 free 12mo, or Cloudflare R2 free)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kavachai-storage

# Razorpay billing (free account; use test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_GUARDIAN=

# Email (Gmail SMTP free, or Brevo 300/day free)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kavachai.in

# Real-time updates (only if you deploy the standalone Socket.io server)
# NEXT_PUBLIC_SOCKET_URL=https://your-socket-host

# Puppeteer (set only if self-hosting PDF generation with a custom chromium path)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
